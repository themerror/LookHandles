<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LookHandles.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LookHandles"
    xmlns:vm="using:LookHandles.ViewModels"
    Title="LookHandles 3.0">

	<Grid x:Name="RootGrid" Padding="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<ScrollViewer x:Name="MainScrollViewer"
					  AutomationProperties.AutomationId="MainScrollViewer"
					  HorizontalScrollMode="Disabled"
					  HorizontalScrollBarVisibility="Disabled"
					  VerticalScrollMode="Enabled"
					  VerticalScrollBarVisibility="Auto">
			<StackPanel x:Name="MainContentPanel">
				<!-- Title -->
				<TextBlock Text="LookHandles 3.0 - Window Spy Tool"
						   FontSize="18"
						   FontWeight="Bold"
						   Margin="0,0,0,12" />

				<!-- Main Content -->
				<Grid x:Name="ContentGrid">
					<Grid.ColumnDefinitions>
						<ColumnDefinition x:Name="LeftPanelColumn" Width="*" />
						<ColumnDefinition x:Name="PanelSpacingColumn" Width="12" />
						<ColumnDefinition x:Name="RightPanelColumn" Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- Left Panel: Window Info -->
					<StackPanel x:Name="LeftPanel" Grid.Row="0" Grid.Column="0">
						<TextBlock Text="Window Information" FontWeight="SemiBold" Margin="0,0,0,8" />

						<StackPanel Spacing="6">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Handle:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.WindowHandle, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Title:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" x:Name="txtWindowTitle" Text="{x:Bind ViewModel.CurrentWindow.WindowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<Button Grid.Column="2" Content="Set Title" Command="{x:Bind ViewModel.SetTitleCommand, Mode=OneWay}" CommandParameter="{x:Bind txtWindowTitle.Text, Mode=OneWay}" Margin="6,0,0,0" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Class:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ClassName, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.WindowType, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Style:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.Style, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="ExStyle:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ExStyle, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Window ID:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.WindowId, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Parent:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ParentWindowHandle, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Prt Class:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ParentClassName, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Prt Title:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ParentWindowText, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="35" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="35" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="45" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Left:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.Left, Mode=OneWay}" IsReadOnly="True" />
							<TextBlock Grid.Column="2" Text="Top:" VerticalAlignment="Center" Margin="4,0,0,0" />
							<TextBox Grid.Column="3" Text="{x:Bind ViewModel.CurrentWindow.Top, Mode=OneWay}" IsReadOnly="True" />
							<TextBlock Grid.Column="4" Text="Rgt:" VerticalAlignment="Center" Margin="4,0,0,0" />
							<TextBox Grid.Column="5" Text="{x:Bind ViewModel.CurrentWindow.Right, Mode=OneWay}" IsReadOnly="True" />
							<TextBlock Grid.Column="6" Text="Btm:" VerticalAlignment="Center" Margin="4,0,0,0" />
							<TextBox Grid.Column="7" Text="{x:Bind ViewModel.CurrentWindow.Bottom, Mode=OneWay}" IsReadOnly="True" />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="50" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="55" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" />
							<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.Width, Mode=OneWay}" IsReadOnly="True" />
							<TextBlock Grid.Column="2" Text="Height:" VerticalAlignment="Center" />
							<TextBox Grid.Column="3" Text="{x:Bind ViewModel.CurrentWindow.Height, Mode=OneWay}" IsReadOnly="True" />
						</Grid>
						</StackPanel>
					</StackPanel>

					<!-- Right Panel: Process Info + Actions -->
					<StackPanel x:Name="RightPanel" Grid.Row="0" Grid.Column="2">
						<TextBlock Text="Process Information" FontWeight="SemiBold" Margin="0,0,0,8" />

						<StackPanel Spacing="6">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="85" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="85" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Thread ID:" VerticalAlignment="Center" />
						<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ThreadId, Mode=OneWay}" IsReadOnly="True" />
						<TextBlock Grid.Column="2" Text="Process ID:" VerticalAlignment="Center" Margin="4,0,0,0" />
						<TextBox Grid.Column="3" Text="{x:Bind ViewModel.CurrentWindow.ProcessId, Mode=OneWay}" IsReadOnly="True" />
					</Grid>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="85" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Process:" VerticalAlignment="Center" />
						<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ProcessName, Mode=OneWay}" IsReadOnly="True" />
					</Grid>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="85" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Path:" VerticalAlignment="Center" />
						<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ProcessPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
					</Grid>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="85" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Instance:" VerticalAlignment="Center" />
						<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.InstanceHandle, Mode=OneWay}" IsReadOnly="True" />
					</Grid>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="85" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Module:" VerticalAlignment="Center" />
						<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ModuleName, Mode=OneWay}" IsReadOnly="True" />
					</Grid>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="85" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Mod Path:" VerticalAlignment="Center" />
						<TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentWindow.ModulePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
					</Grid>
				</StackPanel>

						<Grid Margin="0,12,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Button Grid.Row="0" Grid.Column="0" Content="Minimize" Command="{x:Bind ViewModel.MinimizeCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="0" Grid.Column="1" Content="Maximize" Command="{x:Bind ViewModel.MaximizeCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="0" Grid.Column="2" Content="Normal" Command="{x:Bind ViewModel.RestoreCommand, Mode=OneWay}" Margin="2" />

					<Button Grid.Row="1" Grid.Column="0" Content="Show" Command="{x:Bind ViewModel.ShowCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="1" Grid.Column="1" Content="Hide" Command="{x:Bind ViewModel.HideCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="1" Grid.Column="2" Content="Flash" Command="{x:Bind ViewModel.FlashCommand, Mode=OneWay}" Margin="2" />

					<Button Grid.Row="2" Grid.Column="0" Content="Topmost" Command="{x:Bind ViewModel.SetTopmostCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="2" Grid.Column="1" Content="No Topmost" Command="{x:Bind ViewModel.ClearTopmostCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="2" Grid.Column="2" Content="Close" Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Margin="2" />

					<Button Grid.Row="3" Grid.Column="0" Content="Enable" Command="{x:Bind ViewModel.EnableCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="3" Grid.Column="1" Content="Disable" Command="{x:Bind ViewModel.DisableCommand, Mode=OneWay}" Margin="2" />
					<Button Grid.Row="3" Grid.Column="2" Content="Kill Process" Command="{x:Bind ViewModel.KillProcessCommand, Mode=OneWay}" Margin="2" />
						</Grid>
					</StackPanel>
				</Grid>

				<!-- Bottom Options -->
				<Grid x:Name="BottomOptionsPanel" Margin="0,12,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid x:Name="CheckBoxRow" Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<CheckBox Grid.Column="0" x:Name="chkTopmost" AutomationProperties.AutomationId="chkTopmost" Content="Always on Top" Margin="0,0,8,0" Checked="chkTopmost_Checked" Unchecked="chkTopmost_Unchecked" />
						<CheckBox Grid.Column="1" x:Name="chkAutoMode" AutomationProperties.AutomationId="chkAutoMode" Content="Auto Mode" Margin="0,0,8,0" IsChecked="{x:Bind ViewModel.IsAutoMode, Mode=TwoWay}" />
						<CheckBox Grid.Column="2" x:Name="chkShowHidden" AutomationProperties.AutomationId="chkShowHidden" Content="Show Hidden" Margin="0,0,8,0" IsChecked="{x:Bind ViewModel.ShowHiddenWindows, Mode=TwoWay}" />
						<CheckBox Grid.Column="3" x:Name="chkEnableGrayed" AutomationProperties.AutomationId="chkEnableGrayed" Content="Enable Grayed" IsChecked="{x:Bind ViewModel.EnableGrayed, Mode=TwoWay}" />
					</Grid>

					<Grid x:Name="WindowCommandRow" Grid.Row="1" Margin="0,8,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Button Grid.Column="0" x:Name="btnWindowList" AutomationProperties.AutomationId="btnWindowList" Content="Window List" Click="btnWindowList_Click" Margin="0,0,8,0" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Open the standalone window list" />
						<Button Grid.Column="1" x:Name="btnFindWindow" AutomationProperties.AutomationId="btnFindWindow" Content="{x:Bind ViewModel.FindWindowButtonText, Mode=OneWay}" Click="btnFindWindow_Click" Margin="0,0,8,0" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Click, then click any window to select it" />
						<Button Grid.Column="2" x:Name="btnSpy" AutomationProperties.AutomationId="btnSpy" Content="{x:Bind ViewModel.FollowForegroundButtonText, Mode=OneWay}" Click="btnSpy_Click" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Automatically select the active foreground window" />
					</Grid>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
